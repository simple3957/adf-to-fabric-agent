__pycache__/
*.pyc
.venv/
*.egg-info/
build/
dist/
.pytest_cache/

# Secrets: never commit tokens or local environment files.
.env
*.env
*.pfx
*.pem
*.key

# Per-engagement state: config and secrets pointers only, never commit real
# client data. Keep the folder tracked but ignore its contents.
projects/*
!projects/.gitkeep
